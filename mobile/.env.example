# Base URL of the NestJS backend.
#
# A simulator can use localhost, but a real device cannot — on a phone,
# localhost is the phone. Use the machine's LAN IP:
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.232:3000
#
# EXPO_PUBLIC_* is inlined by Metro at build time, so changing this needs a
# dev-server restart, not just a reload.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
