# Base URL of the NestJS backend.
#
# A simulator can use localhost, but a real device cannot — on a phone,
# localhost is the phone. Use the machine's LAN IP:
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.232:3000
#
# EXPO_PUBLIC_* is inlined by Metro at build time, so changing this needs a
# dev-server restart, not just a reload.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# RevenueCat SDK keys, one per store.
#
# Public by design: they identify the app and cannot grant anything on their
# own. The webhook secret is the one that matters and lives on the backend.
#
# Leaving these empty is a supported state — the paywall then shows prices with
# no buy button, which is also what Expo Go gets, since the native module is
# only linked in a dev build.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
