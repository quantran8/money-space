# Base URL của backend API. Nếu bỏ trống, core fallback về http://localhost:3000.
# Trên Vercel: khai báo biến này trong Project Settings → Environment Variables.
VITE_API_BASE_URL=http://localhost:3000

# PostHog. Bỏ trống là trạng thái được hỗ trợ: không có key thì SDK không được
# khởi tạo và không có request nào được gửi đi — đúng thứ CI và máy dev cần.
#
# Region chốt một lần, không đổi được sau khi tạo project. EU là mặc định: dữ
# liệu ở đây liên quan tới tài chính của hộ gia đình Việt Nam.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
