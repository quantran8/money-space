{
  "name": "money-space-frontend",
  "private": true,
  "version": "0.0.0",
  "description": "Oursight frontend — web (Vite) and mobile (Expo) sharing @money-space/core.",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter family-finance-app dev",
    "build": "pnpm --filter family-finance-app build",
    "lint": "pnpm --filter family-finance-app lint",
    "mobile": "pnpm --filter money-space-mobile start",
    "mobile:typecheck": "pnpm --filter money-space-mobile typecheck",
    "mobile:lint": "pnpm --filter money-space-mobile lint",
    "verify": "pnpm build && pnpm lint && pnpm mobile:typecheck && pnpm mobile:lint"
  }
}
